# Do not commit a real .env file. Set these values in Supabase Edge Function
# Secrets for the deployed project, or copy this to functions/.env locally.

APPLE_ENVIRONMENT=Sandbox
VERIFICATION_SERVICE_URL=https://YOUR_VERCEL_PROJECT.vercel.app/api/verify-apple-transaction
VERIFICATION_SERVICE_SHARED_SECRET=

# The product-owned, OpenAI-compatible provider. These stay on the server.
MANAGED_AI_PROVIDER_BASE_URL=https://api.openai.com/v1
MANAGED_AI_PROVIDER_API_KEY=
MANAGED_AI_PROVIDER_MODEL=gpt-5-mini
